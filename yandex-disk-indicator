#!/bin/bash

# Protection against a second start is implemented in indicator.py (an exclusive lock on the
# ~/.config/yd-tools/yandex-disk-indicator.lock file). Don't try to detect a running instance here:
# the process name of this script depends on the way it is invoked ('bash', 'sh' or the truncated
# script name) and it never matches the indicator process itself.

# exec is used to avoid an extra shell process which takes signals (logout, package upgrade)
# instead of the indicator and leaves it running as an orphan with an icon in the panel.
cd /usr/share/yd-tools
exec python3 indicator.py "$@"
