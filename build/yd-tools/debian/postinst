#! /bin/bash -e
#DEBHELPER#

#echo postinst started
#sleep 3

# Kill the indicator itself (the python process that owns the panel icon), not its shell wrapper:
# a killed wrapper leaves the indicator alive and the restart below adds a second icon to the panel.
for pid in $(pgrep -f 'python[0-9.]* (/usr/share/yd-tools/)?indicator\.py')
do
  #echo $pid will be killed
  USR=`grep -z ^USER= /proc/$pid/environ | sed 's/USER=//'`
  #echo $pid belongs to user:$USR
  DSP=`grep -z ^DISPLAY= /proc/$pid/environ | sed 's/DISPLAY=//'`
  DBUS=`grep -z ^DBUS_SESSION_BUS_ADDRESS= /proc/$pid/environ | sed 's/DBUS_SESSION_BUS_ADDRESS=//'`
  #echo Display = $DSP, DBUS = $DBUS
  kill $pid
  sleep 2
  export DBUS_SESSION_BUS_ADDRESS=$DBUS
  export DISPLAY=$DSP
  su $USR -c "(yandex-disk-indicator&)&"
done

#echo pid:$pid 
#echo postinst finished
exit 0
